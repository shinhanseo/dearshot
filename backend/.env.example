PORT=3000
NODE_ENV=development
LOG_LEVEL=info
AI_PROVIDER=mock
AI_API_KEY=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=dearshot-api
JWT_AUDIENCE=dearshot-android
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_WEB_CLIENT_ID=replace-with-google-web-client-id
KAKAO_APP_ID=replace-with-kakao-app-id
KAKAO_API_TIMEOUT_MS=3000

DATABASE_URL=postgresql://dearshot_app:change-me-local-only@postgres:5432/dearshot
TEST_DATABASE_URL=postgresql://dearshot_app:change-me-local-only@postgres:5432/dearshot_test
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
PUBLIC_ASSET_BASE_URL=http://localhost:3000/assets/catalog
CATALOG_ASSET_ROOT=catalog/assets
UPLOAD_ROOT=/srv/dearshot/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_DIMENSION_PX=8192
UPLOAD_MAX_PIXELS=40000000
UPLOAD_TTL_SECONDS=3600

# AI cost controls use a fixed UTC day boundary. IP limits are secondary to principal limits.
USAGE_TIMEZONE=UTC
GUEST_SCENE_ANALYSES_PER_DAY=5
GUEST_PHOTO_FEEDBACKS_PER_DAY=10
MEMBER_SCENE_ANALYSES_PER_DAY=50
MEMBER_PHOTO_FEEDBACKS_PER_DAY=100
AI_IP_RATE_LIMIT_PER_MINUTE=30
IDEMPOTENCY_TTL_SECONDS=86400

# Remote Android configuration
APP_MINIMUM_SUPPORTED_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_MAINTENANCE=false
APP_CATALOG_VERSION=development
APP_RECOMMENDED_LONG_EDGE_PX=2048
PRIVACY_POLICY_VERSION=2026-09-01
PRIVACY_POLICY_URL=https://dearshot.app/privacy
TERMS_VERSION=2026-09-01
TERMS_URL=https://dearshot.app/terms
FEATURE_KAKAO_LOGIN=true
FEATURE_LOCATION_CONTEXT=true
FEATURE_FEEDBACK_COMPARISON=true

# Validated product events are retained for 90 days. Offline batches may be seven days old.
APP_EVENT_RETENTION_DAYS=90
APP_EVENT_MAX_PAST_AGE_DAYS=7
APP_EVENT_MAX_FUTURE_SKEW_SECONDS=300
