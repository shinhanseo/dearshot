PORT=3000
NODE_ENV=development
LOG_LEVEL=info
AI_PROVIDER=mock
AI_API_KEY=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=dearshot-api
JWT_AUDIENCE=dearshot-android
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_WEB_CLIENT_ID=replace-with-google-web-client-id

DATABASE_URL=postgresql://dearshot_app:change-me-local-only@postgres:5432/dearshot
TEST_DATABASE_URL=postgresql://dearshot_app:change-me-local-only@postgres:5432/dearshot_test
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
